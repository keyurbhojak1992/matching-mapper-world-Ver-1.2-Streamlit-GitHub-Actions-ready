{
  "name": "Matching Mapper World (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["START_HERE.md", "app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "postAttachCommand": {
    "server": "streamlit run app.py"
  },
  "portsAttributes": {
    "8501": {
      "label": "Matching Mapper World",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
